<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_soporte_categoria_tree" model="ir.ui.view">
        <field name="name">soporte.categoria.tree</field>
        <field name="model">soporte.categoria</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_soporte_categoria_form" model="ir.ui.view">
        <field name="name">soporte.categoria.form</field>
        <field name="model">soporte.categoria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>