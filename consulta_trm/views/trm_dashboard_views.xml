<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_trm_dashboard_form" model="ir.ui.view">
        <field name="name">trm.dashboard.form</field>
        <field name="model">trm.dashboard</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="nombre" readonly="1"/>
                        </h1>
                    </div>

                    <div class="row mt32 mb32">
                        <div class="col-12 text-center">
                            <h2>TRM Actual</h2>
                            <div class="display-3">
                                $ <field name="trm_actual" readonly="1"/> COP
                            </div>
                            <p class="text-muted">Pesos Colombianos por Dólar Estadounidense</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 text-center">
                            <strong>Última actualización:</strong>
                            <field name="fecha_actualizacion" readonly="1"/>
                        </div>
                    </div>
                    <div class="row mt32">
                        <div class="col-12 text-center">
                            <button name="%(action_trm_diaria)d" type="action" string="Histórico TRM" class="btn-primary"/>
                        </div>
                    </div>
                    <div class="row mt32">
                        <div class="col-12 text-center">
                            <button name="%(action_trm_consulta)d" type="action" string="Consulta TRM" class="btn-secondary"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>