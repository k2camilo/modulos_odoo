<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_trm_consulta_form" model="ir.ui.view">
        <field name="name">trm.consulta.form</field>
        <field name="model">trm.consulta</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            Consulta TRM Colombiana
                        </h1>
                    </div>
                    <div class="col-12 text-center">
                        <h2>Consulta TRM</h2>
                        <p>Ingrese la fecha para consultar el valor del TRM en pesos colombianos.</p>
                        <field name="fecha" string="Fecha"/>
                        <h3>Resultado de la consulta:</h3>
                        <div class="display-3">
                            $ <field name="valor_cop" string="Valor COP" readonly="1"/> COP
                        </div>
                    </div>
                </sheet>
            </form>
        </field>

    </record>
</odoo>